{% extends 'partials/base.html.twig' %}

{% if form is null %}
    {% set form = grav.session.getFlashObject('form') %}
{% endif %}

{% block content %}
  <article class="post">
    <header>
      <div class="title">
        <h2>{{ form.message }}</h2>
      </div>
      <div class="meta">
          <time class="published" datetime="{{ datestamp }}">{{ datestamp }}</time>
      </div>
    </header>

    {{ page.content|raw }}

    {% if form %}
      {% include 'partials/form-messages.html.twig' %}
      <div>
        <p>{{ 'PLUGIN_FORM.DATA_SUMMARY'|t }}</p>
        {% include "forms/data.html.twig" ignore missing %}
      </div>
    {% else %}
      <div class="alert alert-warning" role="alert">
        <p>{{ 'PLUGIN_FORM.NO_FORM_DATA'|t }}</p>
      </div>
    {% endif %}
  </article>
{% endblock %}
